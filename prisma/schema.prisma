  assignedResources Json       @default("[]") @map("assigned_resources")
  /// Project access scope within the company.
  projectId         String     @map("project_id")
  /// Optional P6 / external project identifier.
  externalProjectId String?    @map("external_project_id") @db.VarChar(255)
  companyId         String     @map("company_id")
  activities        Activity[]
  activityLinks     ActivityDeliverable[]
  activityCodeAssignments ActivityCodeAssignment[]
