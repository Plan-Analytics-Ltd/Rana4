generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum ProjectRole {
  ADMIN
  EDITOR
  VIEWER
}

enum ActivityStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  LOCKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  authUserId   String?  @unique @map("auth_user_id") @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  name         String?  @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  companyId    String   @map("company_id")
  role         Role     @default(VIEWER)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_company_fk")
  projectMemberships ProjectMember[]
  emailVerificationTokens EmailVerificationToken[]
  adminRequests        AdminRequest[]

  @@map("users")
}

model AdminRequest {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// PENDING | APPROVED | REJECTED
  status    String   @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("admin_requests")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@map("email_verification_tokens")
}

model Company {
  id                 String              @id @default(cuid())
  name               String
  joinCode           String              @unique @map("join_code") @db.VarChar(32)
  activities         Activity[]
  activityDeliverables ActivityDeliverable[]
  activityCodeTypes  ActivityCodeType[]
  activityCodes      ActivityCode[]
  activityCodeAssignments ActivityCodeAssignment[]
  assuranceNotes     AssuranceNote[]
  deliverables       Deliverable[]
  fragnets           Fragnet[]
  fragnetActivityTemplates FragnetActivityTemplate[]
  fragnetTemplateRelationships FragnetTemplateRelationship[]
  p6ExternalIds      P6ExternalId[]
  projects           Project[]
  programmeSnapshots ProgrammeSnapshot[]
  intelligenceFindings IntelligenceFinding[]
  learnedInsights              LearnedInsight[]
  deliverableKnowledgeProfiles   DeliverableKnowledgeProfile[]
  deliverableReliabilityProfiles DeliverableReliabilityProfile[]
  deliverableOutcomeProfiles     DeliverableOutcomeProfile[]
  recommendationProfiles       RecommendationProfile[]
  intelligenceTrustProfiles    IntelligenceTrustProfile[]
  engineeringKnowledgeEntries  EngineeringKnowledgeEntry[]
  engineeringRuleProposals     EngineeringRuleProposal[]
  engineeringLearnedRules      EngineeringLearnedRule[]
  relationships                     Relationship[]
  deliverableRelationships          DeliverableRelationship[]
  deliverableActivityRelationships  DeliverableActivityRelationship[]
  activityToDeliverableRelationships ActivityToDeliverableRelationship[]
  standards          Standard[]
  users              User[]

  @@map("companies")
}

enum ScheduleConstraintType {
  AS_SOON_AS_POSSIBLE
  START_NO_EARLIER_THAN
  START_NO_LATER_THAN
  FINISH_NO_EARLIER_THAN
  FINISH_NO_LATER_THAN
  MUST_START_ON
  MUST_FINISH_ON
}

model Project {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  companyId String   @map("company_id")
  /// Soft-archive flag for portfolio analytics filters. Null = active.
  archivedAt DateTime? @map("archived_at")
  /// Anchor for CPM forward pass (calendar working day).
  scheduleStartDate DateTime? @map("schedule_start_date") @db.Date
  company   Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "projects_company_fk")

  members        ProjectMember[]
  standards      Standard[]
  assuranceNotes AssuranceNote[]
  fragnets       Fragnet[]
  fragnetActivityTemplates FragnetActivityTemplate[]
  fragnetTemplateRelationships FragnetTemplateRelationship[]
  deliverables   Deliverable[]
  activities     Activity[]
  activityDeliverables ActivityDeliverable[]
  relationships                     Relationship[]
  deliverableRelationships          DeliverableRelationship[]
  deliverableActivityRelationships  DeliverableActivityRelationship[]
  activityToDeliverableRelationships ActivityToDeliverableRelationship[]
  auditLogs      AuditLog[]
  p6ExternalIds  P6ExternalId[]
  intelligenceProfile ProjectIntelligenceProfile?
  programmeSnapshots  ProgrammeSnapshot[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  role      ProjectRole
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_user_fk")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_members_project_fk")

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Invitation {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(255)
  companyId String   @map("company_id")
  role      Role

  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  companyId String   @map("company_id")
  projectId String   @map("project_id")

  action    String   @db.VarChar(255)
  entity    String   @db.VarChar(255)
  entityId  String?  @map("entity_id") @db.VarChar(255)
  details   Json     @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([companyId, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Standard {
  id             String          @id @default(uuid())
  name           String          @db.VarChar(255)
  description    String?
  createdAt      DateTime        @default(now()) @map("created_at")
  projectId      String          @map("project_id")
  companyId      String          @map("company_id")
  assuranceNotes AssuranceNote[]
  fragnets       Fragnet[]
  company        Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "standards_company_fk")
  project        Project         @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([projectId])
  @@map("standards")
}

model AssuranceNote {
  id         String     @id @default(uuid())
  standardId String     @map("standard_id")
  noteText   String     @map("note_text")
  createdAt  DateTime   @default(now()) @map("created_at")
  projectId  String     @map("project_id")
  companyId  String     @map("company_id")
  activities Activity[]
  company    Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "assurance_notes_company_fk")
  standard   Standard   @relation(fields: [standardId, companyId], references: [id, companyId], onDelete: Cascade)
  project    Project    @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([projectId])
  @@map("assurance_notes")
}

model Fragnet {
  id                    String                      @id @default(uuid())
  standardId            String                      @map("standard_id")
  name                  String                      @db.VarChar(255)
  description           String?
  createdAt             DateTime                    @default(now()) @map("created_at")
  projectId             String                      @map("project_id")
  companyId             String                      @map("company_id")
  activities            Activity[]
  activityTemplates     FragnetActivityTemplate[]
  templateRelationships FragnetTemplateRelationship[]
  deliverables          Deliverable[]
  company               Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fragnets_company_fk")
  standard              Standard                    @relation(fields: [standardId, companyId], references: [id, companyId], onDelete: Cascade)
  project               Project                     @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)
  relationships                     Relationship[]
  deliverableRelationships          DeliverableRelationship[]
  deliverableActivityRelationships  DeliverableActivityRelationship[]
  activityToDeliverableRelationships ActivityToDeliverableRelationship[]

  @@unique([id, companyId])
  @@index([projectId])
  @@map("fragnets")
}

/// Reusable workflow step defined at fragnet level; materialized per deliverable.
model FragnetActivityTemplate {
  id                String                      @id @default(uuid())
  fragnetId         String                      @map("fragnet_id")
  companyId         String                      @map("company_id")
  projectId         String                      @map("project_id")
  templateCode      String                      @map("template_code") @db.VarChar(64)
  name              String                      @db.VarChar(255)
  bestDuration      Int                         @map("best_duration")
  likelyDuration    Int                         @map("likely_duration")
  isSharedAcrossDeliverables Boolean            @default(false) @map("is_shared_across_deliverables")
  orderIndex        Int                         @default(0) @map("order_index")
  assignedResources Json                        @default("[]") @map("assigned_resources")
  createdAt         DateTime                    @default(now()) @map("created_at")
  fragnet           Fragnet                     @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  company           Company                     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fragnet_activity_templates_company_fk")
  project           Project                     @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)
  predecessorIn     FragnetTemplateRelationship[] @relation("TemplatePred")
  successorIn       FragnetTemplateRelationship[] @relation("TemplateSucc")
  materializedActivities Activity[]
  activityCodeAssignments ActivityCodeAssignment[]

  @@unique([id, companyId])
  @@unique([companyId, fragnetId, templateCode])
  @@index([projectId])
  @@map("fragnet_activity_templates")
}

/// Default predecessor/successor links between fragnet activity templates.
model FragnetTemplateRelationship {
  id                    String                 @id @default(uuid())
  fragnetId             String                 @map("fragnet_id")
  companyId             String                 @map("company_id")
  projectId             String                 @map("project_id")
  predecessorTemplateId String                 @map("predecessor_template_id")
  successorTemplateId   String                 @map("successor_template_id")
  relationshipType      RelationshipType       @map("relationship_type")
  lag                   Int                    @default(0)
  createdAt             DateTime               @default(now()) @map("created_at")
  fragnet               Fragnet                @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  company               Company                @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fragnet_template_relationships_company_fk")
  project               Project                @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)
  predecessorTemplate   FragnetActivityTemplate @relation("TemplatePred", fields: [predecessorTemplateId, companyId], references: [id, companyId], onDelete: Cascade)
  successorTemplate     FragnetActivityTemplate @relation("TemplateSucc", fields: [successorTemplateId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([projectId])
  @@map("fragnet_template_relationships")
}

model Activity {
  id                   String                  @id @default(uuid())
  fragnetId            String                  @map("fragnet_id")
  activityCode         String                  @map("activity_code") @db.VarChar(100)
  name                 String                  @db.VarChar(255)
  status               ActivityStatus          @default(DRAFT)
  /// Primavera TASK.task_type (e.g. TT_Task, TT_Rsrc, TT_FinMile) — authoritative import metadata.
  p6TaskType           String?                 @map("p6_task_type") @db.VarChar(32)
  bestDuration         Int                     @map("best_duration")
  likelyDuration       Int                     @map("likely_duration")
  assuranceNoteId      String?                 @map("assurance_note_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  /// JSON array: { resourceType, resourceName, rate, unit, units? } — rate from rate card only
  assignedResources    Json                    @default("[]") @map("assigned_resources")
  deliverableId        String                  @map("deliverable_id")
  projectId            String                  @map("project_id")
  companyId            String                  @map("company_id")
  isSharedAcrossDeliverables Boolean           @default(false) @map("is_shared_across_deliverables")
  isInherited          Boolean                 @default(false) @map("is_inherited")
  templateActivityId   String?                 @map("template_activity_id")
  detachedFromTemplate Boolean                 @default(false) @map("detached_from_template")
  plannedStartDate     DateTime?               @map("planned_start_date") @db.Date
  plannedFinishDate    DateTime?               @map("planned_finish_date") @db.Date
  earlyStart           DateTime?               @map("early_start") @db.Date
  earlyFinish          DateTime?               @map("early_finish") @db.Date
  lateStart            DateTime?               @map("late_start") @db.Date
  lateFinish           DateTime?               @map("late_finish") @db.Date
  totalFloat           Int?                    @map("total_float")
  freeFloat            Int?                    @map("free_float")
  isCritical           Boolean                 @default(false) @map("is_critical")
  drivingRelationshipId String?                @map("driving_relationship_id")
  calendarId           String?                 @map("calendar_id")
  constraintType       ScheduleConstraintType? @map("constraint_type")
  constraintDate       DateTime?               @map("constraint_date") @db.Date
  activityCodeAssignments ActivityCodeAssignment[]
  assuranceNote        AssuranceNote?          @relation(fields: [assuranceNoteId, companyId], references: [id, companyId])
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activities_company_fk")
  deliverable          Deliverable             @relation(fields: [deliverableId, companyId], references: [id, companyId])
  deliverableLinks     ActivityDeliverable[]
  fragnet              Fragnet                 @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  project              Project                 @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)
  template             FragnetActivityTemplate? @relation(fields: [templateActivityId, companyId], references: [id, companyId], onDelete: SetNull)
  predecessorIn        Relationship[]          @relation("Predecessor")
  successorIn          Relationship[]          @relation("Successor")
  deliverablePredecessorIn DeliverableActivityRelationship[] @relation("DeliverableActivitySucc")
  deliverableSuccessorIn   ActivityToDeliverableRelationship[] @relation("ActivityToDeliverablePred")

  @@unique([id, companyId])
  @@unique([companyId, fragnetId, activityCode])
  @@index([projectId])
  @@index([templateActivityId])
  @@map("activities")
}

model ActivityDeliverable {
  id            String      @id @default(uuid())
  activityId    String      @map("activity_id")
  deliverableId String      @map("deliverable_id")
  projectId     String      @map("project_id")
  companyId     String      @map("company_id")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  activity      Activity    @relation(fields: [activityId, companyId], references: [id, companyId], onDelete: Cascade)
  company       Company     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_deliverables_company_fk")
  deliverable   Deliverable @relation(fields: [deliverableId, companyId], references: [id, companyId], onDelete: Cascade)
  project       Project     @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([activityId, deliverableId])
  @@index([deliverableId])
  @@index([projectId])
  @@map("activity_deliverables")
}

/// P6 Activity Code Type (ACTVTYPE) — company-wide catalog.
model ActivityCodeType {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  slug        String         @db.VarChar(64)
  name        String         @db.VarChar(255)
  shortName   String?        @map("short_name") @db.VarChar(64)
  seqNum      Int            @default(0) @map("seq_num")
  createdAt   DateTime       @default(now()) @map("created_at")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_code_types_company_fk")
  codes       ActivityCode[]
  assignments ActivityCodeAssignment[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("activity_code_types")
}

/// P6 Activity Code value (ACTVCODE) — hierarchical optional parent.
model ActivityCode {
  id          String         @id @default(cuid())
  companyId   String         @map("company_id")
  typeId      String         @map("type_id")
  parentId    String?        @map("parent_id")
  name        String         @db.VarChar(255)
  shortName   String?        @map("short_name") @db.VarChar(64)
  seqNum      Int            @default(0) @map("seq_num")
  color       String?        @db.VarChar(32)
  createdAt   DateTime       @default(now()) @map("created_at")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_codes_company_fk")
  type        ActivityCodeType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  parent      ActivityCode?  @relation("ActivityCodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ActivityCode[] @relation("ActivityCodeHierarchy")
  assignments ActivityCodeAssignment[]

  @@unique([companyId, typeId, name])
  @@index([companyId])
  @@index([typeId])
  @@map("activity_codes")
}

/// At most one code per type per activity or per deliverable (P6). Exactly one of activityId / deliverableId is set.
model ActivityCodeAssignment {
  id                   String                   @id @default(cuid())
  activityId           String?                  @map("activity_id")
  deliverableId        String?                  @map("deliverable_id")
  templateActivityId   String?                  @map("template_activity_id")
  typeId               String                   @map("type_id")
  codeId               String                   @map("code_id")
  companyId            String                   @map("company_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  activity             Activity?                @relation(fields: [activityId, companyId], references: [id, companyId], onDelete: Cascade)
  deliverable          Deliverable?             @relation(fields: [deliverableId, companyId], references: [id, companyId], onDelete: Cascade)
  templateActivity     FragnetActivityTemplate? @relation(fields: [templateActivityId, companyId], references: [id, companyId], onDelete: Cascade)
  type                 ActivityCodeType         @relation(fields: [typeId], references: [id], onDelete: Cascade)
  code                 ActivityCode             @relation(fields: [codeId], references: [id], onDelete: Cascade)
  company              Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_code_assignments_company_fk")

  @@index([companyId])
  @@index([codeId])
  @@index([deliverableId])
  @@index([templateActivityId])
  @@map("activity_code_assignments")
}

/// Stable numeric IDs for P6 spreadsheet / XER alignment (scoped per company + project).
model P6ExternalId {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  projectId    String   @map("project_id")
  entityKind   String   @map("entity_kind") @db.VarChar(32)
  entityKey    String   @map("entity_key") @db.VarChar(512)
  p6NumericId  Int      @map("p6_numeric_id")
  createdAt    DateTime @default(now()) @map("created_at")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "p6_external_ids_company_fk")
  project      Project  @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, projectId, entityKind, entityKey])
  @@index([companyId, projectId])
  @@map("p6_external_ids")
}

model Relationship {
  id                    String           @id @default(uuid())
  fragnetId             String           @map("fragnet_id")
  predecessorActivityId String           @map("predecessor_activity_id")
  successorActivityId   String           @map("successor_activity_id")
  relationshipType      RelationshipType @map("relationship_type")
  lag                   Int              @default(0)
  projectId             String           @map("project_id")
  companyId             String           @map("company_id")
  company               Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "relationships_company_fk")
  fragnet               Fragnet          @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  predecessorActivity   Activity         @relation("Predecessor", fields: [predecessorActivityId, companyId], references: [id, companyId], onDelete: Cascade)
  successorActivity     Activity         @relation("Successor", fields: [successorActivityId, companyId], references: [id, companyId], onDelete: Cascade)
  project               Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([projectId])
  @@map("relationships")
}

/// Cross-deliverable logic (deliverable rows act as P6 summary tasks on export).
model DeliverableRelationship {
  id                       String           @id @default(uuid())
  fragnetId                String           @map("fragnet_id")
  predecessorDeliverableId String           @map("predecessor_deliverable_id")
  successorDeliverableId   String           @map("successor_deliverable_id")
  relationshipType         RelationshipType @map("relationship_type")
  lag                      Int              @default(0)
  projectId                String           @map("project_id")
  companyId                String           @map("company_id")
  company                  Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deliverable_relationships_company_fk")
  fragnet                  Fragnet          @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  predecessorDeliverable   Deliverable      @relation("DeliverablePred", fields: [predecessorDeliverableId, companyId], references: [id, companyId], onDelete: Cascade)
  successorDeliverable     Deliverable      @relation("DeliverableSucc", fields: [successorDeliverableId, companyId], references: [id, companyId], onDelete: Cascade)
  project                  Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([projectId])
  @@index([fragnetId])
  @@map("deliverable_relationships")
}

/// Deliverable summary task → activity (P6 export: deliverable TASK row → activity TASK row).
model DeliverableActivityRelationship {
  id                       String           @id @default(uuid())
  fragnetId                String           @map("fragnet_id")
  predecessorDeliverableId String           @map("predecessor_deliverable_id")
  successorActivityId      String           @map("successor_activity_id")
  relationshipType         RelationshipType @map("relationship_type")
  lag                      Int              @default(0)
  projectId                String           @map("project_id")
  companyId                String           @map("company_id")
  company                  Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "deliverable_activity_relationships_company_fk")
  fragnet                  Fragnet          @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  predecessorDeliverable   Deliverable      @relation("DeliverableActivityPred", fields: [predecessorDeliverableId, companyId], references: [id, companyId], onDelete: Cascade)
  successorActivity        Activity         @relation("DeliverableActivitySucc", fields: [successorActivityId, companyId], references: [id, companyId], onDelete: Cascade)
  project                  Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([fragnetId, predecessorDeliverableId, successorActivityId, relationshipType])
  @@index([projectId])
  @@index([fragnetId])
  @@map("deliverable_activity_relationships")
}

/// Shared (or other) activity → deliverable summary (activity drives linked deliverable blocks).
model ActivityToDeliverableRelationship {
  id                     String           @id @default(uuid())
  fragnetId              String           @map("fragnet_id")
  predecessorActivityId  String           @map("predecessor_activity_id")
  successorDeliverableId String           @map("successor_deliverable_id")
  relationshipType       RelationshipType @map("relationship_type")
  lag                    Int              @default(0)
  projectId              String           @map("project_id")
  companyId              String           @map("company_id")
  company                Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "activity_to_deliverable_relationships_company_fk")
  fragnet                Fragnet          @relation(fields: [fragnetId, companyId], references: [id, companyId], onDelete: Cascade)
  predecessorActivity    Activity         @relation("ActivityToDeliverablePred", fields: [predecessorActivityId, companyId], references: [id, companyId], onDelete: Cascade)
  successorDeliverable   Deliverable      @relation("ActivityToDeliverableSucc", fields: [successorDeliverableId, companyId], references: [id, companyId], onDelete: Cascade)
  project                Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([fragnetId, predecessorActivityId, successorDeliverableId, relationshipType])
  @@index([projectId])
  @@index([fragnetId])
  @@map("activity_to_deliverable_relationships")
}

model Deliverable {
  id                String     @id @default(uuid())
  name              String     @db.VarChar(255)
