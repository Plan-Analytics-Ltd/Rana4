model DeliverableSnapshot {
  id            String    @id @default(cuid())
  snapshotId    String    @map("snapshot_id")
  deliverableId String?   @map("deliverable_id")
  name          String    @db.VarChar(255)
  classification DeliverableClassification?
  plannedStart  DateTime? @map("planned_start") @db.Date
  plannedFinish DateTime? @map("planned_finish") @db.Date
  actualStart   DateTime? @map("actual_start") @db.Date
  actualFinish  DateTime? @map("actual_finish") @db.Date
  totalFloat    Int?      @map("total_float")
  status        String?   @db.VarChar(32)
  classificationTags Json @default("{}") @map("classification_tags")
  /// Dominant work package at capture (from linked activities or live deliverable)
  fragnetId     String?   @map("fragnet_id")
  /// Fragnet / WBS label frozen at capture time
  parentWbs     String?   @map("parent_wbs") @db.VarChar(255)
  /// WBS path frozen at capture time (fragnet name when hierarchy unavailable)
  wbsPath       String?   @map("wbs_path") @db.VarChar(512)
  /// Resolved planning stage frozen at capture time
  stage         String?   @db.VarChar(64)
  /// Resolved discipline frozen at capture time
  discipline    String?   @db.VarChar(64)
  /// Canonical planner-equivalent work-package duration (Phase 10 normalisation)
  workPackageDurationDays Int?  @map("work_package_duration_days")
  /// How workPackageDurationDays was derived: WORK_PACKAGE | MILESTONE | CALENDAR_SPAN_FALLBACK
  durationBasis String?   @map("duration_basis") @db.VarChar(32)
  /// Pre-computed Engineering Reasoning identity (Phase 2). Null = fall back to rule-based.
  reasonedDiscipline        String?   @map("reasoned_discipline") @db.VarChar(64)
  reasonedEngineeringObject String?   @map("reasoned_engineering_object") @db.VarChar(64)
  reasonedEngineeringWork   String?   @map("reasoned_engineering_work") @db.VarChar(64)
  reasonedDeliverableType   String?   @map("reasoned_deliverable_type") @db.VarChar(64)
  reasonedLifecycleStage    String?   @map("reasoned_lifecycle_stage") @db.VarChar(64)
  /// RULE_BASED | LLM_REASONED | LLM_MERGED | null (never computed — pre-dates this feature or reasoning disabled at capture)
  reasoningSource           String?   @map("reasoning_source") @db.VarChar(16)
  reasoningComputedAt       DateTime? @map("reasoning_computed_at")

  snapshot ProgrammeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([deliverableId])
  @@map("deliverable_snapshots")
}

/// Logic captured at import for variance analysis.
model RelationshipSnapshot {
