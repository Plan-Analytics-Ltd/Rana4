/// Normalized project metadata for benchmarking and future AI recommendations.
model ProjectIntelligenceProfile {
  id        String   @id @default(cuid())
  projectId String   @unique @map("project_id")
  companyId String   @map("company_id")
  /// e.g. healthcare, education, commercial (broader than projectType)
  sector                String? @db.VarChar(64)
  /// e.g. healthcare, education, commercial
  projectType           String? @map("project_type") @db.VarChar(64)
  procurementRoute      String? @map("procurement_route") @db.VarChar(64)
  /// Primary RIBA stage at programme generation
  primaryRibaStage      String? @map("primary_riba_stage") @db.VarChar(32)
  /// Canonical stage label (may differ from RIBA)
  stage                 String? @db.VarChar(64)
  region                String? @db.VarChar(64)
  clientType            String? @map("client_type") @db.VarChar(64)
  /// Complexity category (e.g. LOW/MEDIUM/HIGH) — separate from numeric score.
  complexity            String? @db.VarChar(64)
  /// 0–1 normalized complexity score for portfolio comparison
  complexityScore       Float?  @map("complexity_score")
  /// disciplineCategories, approvalRouteCategories, healthcareDepartments, deliverableClassifications, etc.
  classificationTags    Json    @default("{}") @map("classification_tags")
  /// Canonical list-style tags for similarity matching.
  classificationTagsList Json   @default("[]") @map("classification_tags_list")
  disciplineTags        Json    @default("[]") @map("discipline_tags")
  /// Derived metrics: activity count, critical path length, MEP density, etc.
  complexityMetrics     Json    @default("{}") @map("complexity_metrics")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, projectType])
  @@map("project_intelligence_profiles")
}

/// Immutable point-in-time programme state. Never overwrites live schedule.
model ProgrammeSnapshot {
  id              String                      @id @default(cuid())
  projectId       String                      @map("project_id")
  companyId       String                      @map("company_id")
  importedAt      DateTime                    @default(now()) @map("imported_at")
  sourceType      ProgrammeSnapshotSourceType @map("source_type")
  snapshotRole    ProgrammeSnapshotRole?      @map("snapshot_role")
  programmeState  ProgrammeState?             @map("programme_state")
  scheduleDate    DateTime?                   @map("schedule_date") @db.Date
  createdByUserId String?                     @map("created_by_user_id")
  /// Import confidence for snapshot metadata classification
  importConfidenceLevel String?               @map("import_confidence_level") @db.VarChar(16)
  importConfidenceScore Float?                @map("import_confidence_score")
  snapshotVersion Int                         @default(1) @map("snapshot_version")
  label           String?                     @db.VarChar(255)
  sourceFileName  String?                     @map("source_file_name") @db.VarChar(512)
  /// Project-level scheduling metrics at capture time
  metrics         Json                        @default("{}")
  /// Import match stats, warnings, unmatched activity codes
  importSummary   Json                        @default("{}") @map("import_summary")
  /// Project metadata captured/edited per snapshot (nullable for backwards compatibility)
  sector          String?                     @db.VarChar(64)
  projectType     String?                     @map("project_type") @db.VarChar(64)
  procurementRoute String?                    @map("procurement_route") @db.VarChar(64)
  stage           String?                     @db.VarChar(64)
  region          String?                     @db.VarChar(64)
  clientType      String?                     @map("client_type") @db.VarChar(64)
  complexity      String?                     @db.VarChar(64)
  disciplineTags  Json                        @default("[]") @map("discipline_tags")
  projectTags     Json                        @default("[]") @map("project_tags")
  classificationTagsList Json                 @default("[]") @map("classification_tags_list")

  project              Project                 @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "programme_snapshots_company_fk")
  activitySnapshots    ActivitySnapshot[]
  deliverableSnapshots DeliverableSnapshot[]
  relationshipSnapshots RelationshipSnapshot[]

  @@index([projectId, importedAt])
  @@index([companyId, importedAt])
  @@index([companyId, sourceType])
  @@map("programme_snapshots")
}

model ActivitySnapshot {
  id                 String   @id @default(cuid())
  snapshotId         String   @map("snapshot_id")
  /// Matched live activity when identity preserved
  activityId         String?  @map("activity_id")
  activityCode       String   @map("activity_code") @db.VarChar(100)
  deliverableId      String?  @map("deliverable_id")
  fragnetId          String?  @map("fragnet_id")
  name               String?  @db.VarChar(255)
  originalDuration   Int?     @map("original_duration")
  remainingDuration  Int?     @map("remaining_duration")
  actualDuration     Int?     @map("actual_duration")
  percentComplete    Float?   @map("percent_complete")
  startDate          DateTime? @map("start_date") @db.Date
  finishDate         DateTime? @map("finish_date") @db.Date
  earlyStart         DateTime? @map("early_start") @db.Date
  earlyFinish        DateTime? @map("early_finish") @db.Date
  lateStart          DateTime? @map("late_start") @db.Date
  lateFinish         DateTime? @map("late_finish") @db.Date
