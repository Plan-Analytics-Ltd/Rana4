# Server
PORT=3001
NODE_ENV=development

# Production (Render/Vercel/etc.): set NODE_ENV=production and all secrets below.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Each secret must be unique (server rejects reuse). Min lengths enforced at startup.
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
DB_ENCRYPTION_KEY=your-db-encryption-key-min-16-chars
APPROVAL_SIGNING_SECRET=your-approval-signing-secret-min-32-chars
AUDIT_SIGNING_SECRET=your-audit-signing-secret-min-32-chars
# Use the SAME DB_ENCRYPTION_KEY as local/dev if this database already has encrypted blobs.

# Private dev panel (same app URL path /dev + API /dev/*): only this account (recommended).
DEV_PANEL_EMAIL=aelsaman@plananalytics.co.uk
#
# Optional fallback: comma-separated list if DEV_PANEL_EMAIL is unset.
# DEV_EMAILS=you@example.com

# Optional: show activity templates / materialize tools on the Activities page (default: hidden)
# NEXT_PUBLIC_SHOW_ACTIVITY_DEV_TOOLS=true

# Internal access control: only emails from this domain can register/login.
# ALLOWED_EMAIL_DOMAIN=plananalytics.co.uk

# CORS: comma-separated HTTPS origins (required in production; leave unset in dev to allow any origin).
# CORS_ORIGIN=https://your-frontend.vercel.app,https://app.example.com

# App URL (used in emails for where to verify)
# APP_URL=http://localhost:3001

# SMTP (optional). If not set, emails are logged to console in dev.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Rana4 <no-reply@yourdomain.com>"

# ZeroBounce API key for email validation on signup (optional; if unset, validation is skipped)
# ZEROBOUNCE_API_KEY=

# AI Explanation Layer (Phase 6B — OpenAI provider)
# OPENAI_API_KEY=
# AI_EXPLANATION_ENABLED=false
# AI_EXPLANATION_PROVIDER=mock
# AI_EXPLANATION_MODEL=gpt-4.1-mini
# AI_EXPLANATION_TEMPERATURE=0.2
# AI_EXPLANATION_MAX_TOKENS=   # optional; omit for no cap (model default). Set a positive number to limit length.
# AI_SYSTEM_PROMPT_OVERRIDE=
# AI_EXPLANATION_DEBUG_PROMPTS=true

# Neon PostgreSQL (get connection string from https://neon.tech)
# Use Neon's *pooled* connection string for the API (host often ends with -pooler).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
