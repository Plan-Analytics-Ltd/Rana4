{
  "name": "rana4",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test:api": "node scripts/test-api.mjs",
    "test:wbs-stage2": "tsx scripts/wbs-stage2-smoke.ts",
    "test:wbs-stage3": "tsx scripts/wbs-stage3-smoke.ts",
    "test:wbs-stage4": "tsx scripts/wbs-stage4-smoke.ts",
    "test:wbs-stage5": "tsx scripts/wbs-stage5-smoke.ts",
    "test:wbs-stage6": "tsx scripts/wbs-stage6-export-smoke.ts",
    "test:wbs-stage7": "tsx scripts/wbs-stage7-smoke.ts",
    "test:p6-resources": "tsc && node scripts/p6-resource-map-smoke.mjs",
    "test:xer-regression": "npm run build && node scripts/xer-regression-suite.mjs",
    "test:cpm-scheduler": "npm run build && node --test scripts/cpm-scheduler.test.mjs",
    "test:tenant-isolation": "tsc && node --test scripts/tenant-isolation.test.mjs",
    "test:project-access": "tsc && node --test scripts/project-access.test.mjs",
    "test:explanation-pipeline": "tsc && node --test scripts/explanation-pipeline.test.mjs",
    "test:explanation-prompt-hygiene": "tsc && node --test scripts/explanation-prompt-hygiene.test.mjs",
    "test:explanation-validator": "tsc && node --test scripts/explanation-validator.test.mjs",
    "test:explanation-openai": "tsc && node --test scripts/explanation-openai-provider.test.mjs",
    "test:openai-key": "tsc && node scripts/openai-key-smoke.mjs",
    "validate:e2e": "tsc && node scripts/e2e-validation.mjs",
    "test:security": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:repair-checksums": "tsx scripts/repair-prisma-migration-checksums.ts",
    "db:reconcile-drift-sql": "tsx scripts/generate-reconcile-to-migrations-sql.ts",
    "db:reconcile-no-drops": "tsx scripts/prepare-reconcile-without-drops.ts",
    "db:apply-reconcile": "node node_modules/prisma/build/index.js db execute --schema prisma/schema.prisma --file scripts/reconcile-to-migrations.generated.sql",
    "db:apply-reconcile-no-drops": "node node_modules/prisma/build/index.js db execute --schema prisma/schema.prisma --file scripts/reconcile-to-migrations.no-drops.sql",
    "db:resolve-activity-codes-migration": "node node_modules/prisma/build/index.js migrate resolve --schema prisma/schema.prisma --applied 20260514120000_activity_codes_p6_ids",
    "db:migrate-status": "node node_modules/prisma/build/index.js migrate status --schema prisma/schema.prisma",
    "db:emit-access-requests-baseline": "tsx scripts/emit-access-requests-baseline-migration.ts",
    "plan-analytics:join-code": "tsx scripts/set-plan-analytics-join-code.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
